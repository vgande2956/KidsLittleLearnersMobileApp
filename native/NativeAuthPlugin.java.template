package __PACKAGE__;

import android.webkit.CookieManager;
import android.webkit.ValueCallback;
import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.CapacitorPlugin;
import java.io.BufferedReader;
import java.io.InputStream;
import java.io.InputStreamReader;
import java.net.HttpURLConnection;
import java.net.URL;
import java.nio.charset.StandardCharsets;
import java.util.List;
import java.util.Map;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;
import org.json.JSONException;

@CapacitorPlugin(name = "NativeAuth")
public class NativeAuthPlugin extends Plugin {
    private static final String API_ORIGIN = "https://kidslearningapp-94co.onrender.com";
    private final ExecutorService executor = Executors.newSingleThreadExecutor();

    @PluginMethod
    public void request(PluginCall call) {
        String action = call.getString("action", "");
        JSObject data = call.getObject("data", new JSObject());
        String path;
        String method = "POST";

        switch (action) {
            case "login":
                path = "/api/auth/login";
                break;
            case "signup":
                path = "/api/auth/signup";
                break;
            case "resendVerification":
                path = "/api/auth/resend-verification";
                break;
            case "logout":
                path = "/api/auth/logout";
                break;
            case "session":
                path = "/api/auth/session";
                method = "GET";
                break;
            default:
                call.reject("Unsupported account action.");
                return;
        }

        String requestPath = path;
        String requestMethod = method;
        executor.execute(() -> performRequest(call, requestPath, requestMethod, data));
    }

    private void performRequest(PluginCall call, String path, String method, JSObject data) {
        HttpURLConnection connection = null;
        try {
            URL url = new URL(API_ORIGIN + path);
            connection = (HttpURLConnection) url.openConnection();
            connection.setRequestMethod(method);
            connection.setConnectTimeout(15000);
            connection.setReadTimeout(20000);
            connection.setUseCaches(false);
            connection.setRequestProperty("Accept", "application/json");

            CookieManager cookieManager = CookieManager.getInstance();
            String cookies = cookieManager.getCookie(API_ORIGIN);
            if (cookies != null && !cookies.isEmpty()) {
                connection.setRequestProperty("Cookie", cookies);
            }

            if (!"GET".equals(method)) {
                connection.setDoOutput(true);
                connection.setRequestProperty("Content-Type", "application/json; charset=utf-8");
                byte[] body = data.toString().getBytes(StandardCharsets.UTF_8);
                connection.getOutputStream().write(body);
            }

            int status = connection.getResponseCode();
            saveResponseCookies(cookieManager, connection.getHeaderFields());
            InputStream stream = status >= 400 ? connection.getErrorStream() : connection.getInputStream();
            String responseBody = stream == null ? "" : readBody(stream);

            JSObject response = new JSObject();
            response.put("status", status);
            response.put("data", parseResponse(responseBody));
            call.resolve(response);
        } catch (Exception exception) {
            call.reject("Could not reach the account service.", exception);
        } finally {
            if (connection != null) connection.disconnect();
        }
    }

    private void saveResponseCookies(CookieManager cookieManager, Map<String, List<String>> headers)
        throws InterruptedException {
        for (Map.Entry<String, List<String>> entry : headers.entrySet()) {
            if (entry.getKey() == null || !"set-cookie".equalsIgnoreCase(entry.getKey())) continue;
            for (String cookie : entry.getValue()) {
                CountDownLatch latch = new CountDownLatch(1);
                getActivity().runOnUiThread(() ->
                    cookieManager.setCookie(API_ORIGIN, cookie, (ValueCallback<Boolean>) ignored -> latch.countDown())
                );
                if (!latch.await(5, TimeUnit.SECONDS)) {
                    throw new IllegalStateException("Timed out saving the account session.");
                }
            }
        }
        cookieManager.flush();
    }

    private String readBody(InputStream stream) throws Exception {
        try (BufferedReader reader = new BufferedReader(new InputStreamReader(stream, StandardCharsets.UTF_8))) {
            StringBuilder body = new StringBuilder();
            String line;
            while ((line = reader.readLine()) != null) body.append(line);
            return body.toString();
        }
    }

    private JSObject parseResponse(String body) throws JSONException {
        if (body == null || body.isEmpty()) return new JSObject();
        try {
            return new JSObject(body);
        } catch (JSONException exception) {
            JSObject response = new JSObject();
            response.put("error", "The account service returned an unreadable response.");
            return response;
        }
    }

    @Override
    protected void handleOnDestroy() {
        executor.shutdownNow();
        super.handleOnDestroy();
    }
}
