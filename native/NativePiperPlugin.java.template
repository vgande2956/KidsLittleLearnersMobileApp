package __PACKAGE__;

import android.content.Context;
import android.content.res.AssetManager;
import android.media.AudioAttributes;
import android.media.AudioFormat;
import android.media.AudioTrack;
import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.CapacitorPlugin;
import com.k2fsa.sherpa.onnx.GeneratedAudio;
import com.k2fsa.sherpa.onnx.OfflineTts;
import com.k2fsa.sherpa.onnx.OfflineTtsConfig;
import com.k2fsa.sherpa.onnx.OfflineTtsModelConfig;
import com.k2fsa.sherpa.onnx.OfflineTtsVitsModelConfig;
import java.io.File;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.io.OutputStream;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.Future;

// Offline, open-source neural voices (Piper models running on sherpa-onnx), bundled in the app.
@CapacitorPlugin(name = "PiperVoice")
public class NativePiperPlugin extends Plugin {
    private static final String DATA_VERSION = "v1";
    private final ExecutorService player = Executors.newSingleThreadExecutor();
    private final ExecutorService generator = Executors.newSingleThreadExecutor();
    private final Object ttsLock = new Object();
    private final Map<String, OfflineTts> engines = new HashMap<>();
    private volatile long token = 0;
    private volatile AudioTrack track;
    private File dataRoot;

    private synchronized File ensureData() throws Exception {
        if (dataRoot != null) return dataRoot;
        Context context = getContext();
        File root = new File(context.getFilesDir(), "tts-" + DATA_VERSION);
        File marker = new File(root, ".ready");
        if (!marker.exists()) {
            copyAssets(context.getAssets(), "tts", root);
            if (!marker.createNewFile() && !marker.exists()) throw new IllegalStateException("Cannot finish voice setup");
        }
        dataRoot = root;
        return root;
    }

    private void copyAssets(AssetManager assets, String from, File to) throws Exception {
        String[] children = assets.list(from);
        if (children != null && children.length > 0) {
            if (!to.exists() && !to.mkdirs()) throw new IllegalStateException("Cannot create " + to);
            for (String child : children) copyAssets(assets, from + "/" + child, new File(to, child));
            return;
        }
        try (InputStream in = assets.open(from); OutputStream out = new FileOutputStream(to)) {
            byte[] buffer = new byte[64 * 1024];
            int read;
            while ((read = in.read(buffer)) > 0) out.write(buffer, 0, read);
        }
    }

    private OfflineTts engine(String code) throws Exception {
        synchronized (ttsLock) {
            OfflineTts existing = engines.get(code);
            if (existing != null) return existing;
            File root = ensureData();
            File model = new File(root, code + "/model.onnx");
            if (!model.exists()) return null;
            OfflineTtsVitsModelConfig vits = new OfflineTtsVitsModelConfig();
            vits.setModel(model.getAbsolutePath());
            vits.setTokens(new File(root, code + "/tokens.txt").getAbsolutePath());
            vits.setDataDir(new File(root, "espeak-ng-data").getAbsolutePath());
            OfflineTtsModelConfig modelConfig = new OfflineTtsModelConfig();
            modelConfig.setVits(vits);
            modelConfig.setNumThreads(Math.max(2, Math.min(4, Runtime.getRuntime().availableProcessors() / 2)));
            OfflineTtsConfig config = new OfflineTtsConfig();
            config.setModel(modelConfig);
            OfflineTts created = new OfflineTts(null, config);
            engines.put(code, created);
            return created;
        }
    }

    private static String codeFor(String lang) {
        String value = lang == null ? "en" : lang.toLowerCase();
        if (value.startsWith("te")) return "te";
        if (value.startsWith("en")) return "en";
        return null;
    }

    private static List<String> sentences(String text) {
        List<String> parts = new ArrayList<>();
        StringBuilder current = new StringBuilder();
        for (int i = 0; i < text.length(); i++) {
            char c = text.charAt(i);
            current.append(c);
            boolean end = c == '.' || c == '!' || c == '?' || c == '\u0964' || c == '\n' || c == ';';
            if (end && current.toString().trim().length() >= 12) {
                parts.add(current.toString().trim());
                current.setLength(0);
            }
        }
        if (current.toString().trim().length() > 0) parts.add(current.toString().trim());
        return parts;
    }

    @PluginMethod
    public void prepare(PluginCall call) {
        player.execute(() -> {
            JSObject result = new JSObject();
            for (String code : new String[] {"en", "te"}) {
                boolean ok;
                try {
                    ok = engine(code) != null;
                } catch (Throwable error) {
                    ok = false;
                }
                result.put(code, ok);
            }
            call.resolve(result);
        });
    }

    @PluginMethod
    public void stop(PluginCall call) {
        halt();
        call.resolve();
    }

    private void halt() {
        token++;
        AudioTrack active = track;
        if (active != null) {
            try {
                active.pause();
                active.flush();
            } catch (Throwable ignored) {
            }
        }
    }

    @PluginMethod
    public void speak(PluginCall call) {
        final String text = call.getString("text", "");
        final String code = codeFor(call.getString("lang", "en-IN"));
        final float speed = Math.max(0.5f, Math.min(call.getFloat("speed", 0.95f), 1.4f));
        final float pitch = Math.max(0.8f, Math.min(call.getFloat("pitch", 1f), 1.25f));
        final float volume = Math.max(0f, Math.min(call.getFloat("volume", 1f), 1f));
        if (code == null || text.trim().isEmpty()) {
            call.reject("unsupported");
            return;
        }
        final long myToken = ++token;
        AudioTrack previous = track;
        if (previous != null) {
            try {
                previous.pause();
                previous.flush();
            } catch (Throwable ignored) {
            }
        }
        player.execute(() -> {
            if (myToken != token) {
                call.resolve(cancelled());
                return;
            }
            AudioTrack out = null;
            try {
                OfflineTts tts = engine(code);
                if (tts == null) {
                    call.reject("unsupported");
                    return;
                }
                List<String> parts = sentences(text);
                // Pitch is approximated by resampling, with speed compensated so tempo stays the same.
                final float genSpeed = speed / pitch;
                int sampleRate = Math.round(tts.sampleRate() * pitch);
                int minBuffer = AudioTrack.getMinBufferSize(sampleRate, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_FLOAT);
                out = new AudioTrack.Builder()
                    .setAudioAttributes(new AudioAttributes.Builder()
                        .setUsage(AudioAttributes.USAGE_MEDIA)
                        .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
                        .build())
                    .setAudioFormat(new AudioFormat.Builder()
                        .setEncoding(AudioFormat.ENCODING_PCM_FLOAT)
                        .setSampleRate(sampleRate)
                        .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
                        .build())
                    .setBufferSizeInBytes(Math.max(minBuffer, sampleRate * 4))
                    .setTransferMode(AudioTrack.MODE_STREAM)
                    .build();
                out.setVolume(volume);
                track = out;
                final AudioTrack active = out;
                boolean started = false;
                long frames = 0;
                Future<GeneratedAudio> next = parts.isEmpty() ? null : submit(tts, parts.get(0), genSpeed);
                for (int i = 0; i < parts.size(); i++) {
                    GeneratedAudio audio = next.get();
                    next = i + 1 < parts.size() ? submit(tts, parts.get(i + 1), genSpeed) : null;
                    if (myToken != token) break;
                    float[] samples = audio.getSamples();
                    if (samples == null || samples.length == 0) continue;
                    if (!started) {
                        started = true;
                        active.play();
                    }
                    int offset = 0;
                    while (offset < samples.length && myToken == token) {
                        int wrote = active.write(samples, offset, Math.min(4096, samples.length - offset), AudioTrack.WRITE_BLOCKING);
                        if (wrote <= 0) break;
                        offset += wrote;
                    }
                    frames += samples.length;
                    if (i + 1 < parts.size() && myToken == token) {
                        float[] gap = new float[sampleRate / 5];
                        active.write(gap, 0, gap.length, AudioTrack.WRITE_BLOCKING);
                        frames += gap.length;
                    }
                }
                if (myToken == token && started) {
                    long deadline = System.currentTimeMillis() + frames * 1000L / sampleRate + 3000;
                    while (myToken == token && active.getPlaybackHeadPosition() < frames && System.currentTimeMillis() < deadline) {
                        Thread.sleep(40);
                    }
                }
                if (myToken == token) {
                    call.resolve(new JSObject().put("cancelled", false));
                } else {
                    call.resolve(cancelled());
                }
            } catch (Throwable error) {
                call.reject(String.valueOf(error.getMessage()));
            } finally {
                if (out != null) {
                    try {
                        out.stop();
                    } catch (Throwable ignored) {
                    }
                    out.release();
                    if (track == out) track = null;
                }
            }
        });
    }

    private Future<GeneratedAudio> submit(OfflineTts tts, String sentence, float speed) {
        return generator.submit(() -> {
            synchronized (ttsLock) {
                return tts.generate(sentence, 0, speed);
            }
        });
    }

    private static JSObject cancelled() {
        return new JSObject().put("cancelled", true);
    }
}
