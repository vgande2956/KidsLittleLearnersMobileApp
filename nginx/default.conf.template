server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;

  location = /health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /api/auth/ {
    proxy_pass https://kidslearningapp-94co.onrender.com;
    proxy_ssl_server_name on;
    proxy_set_header Host kidslearningapp-94co.onrender.com;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
